{
  "name": "Mobile-Desktop Template",
  "version": "0.4.0",
  "private": true,
  "description": "Mobile-Desktop Template",
  "workspaces": [
    "Desktop",
    "Mobile"
  ],
  "scripts": {
    "start:desktop": "npm run build:mobile:electron && npm run start --workspace=Desktop",
    "start:mobile": "npm run start --workspace=Mobile",
    "format": "prettier --write Desktop/ Mobile/",
    "format:desktop": "prettier --write Desktop/",
    "format:mobile": "prettier --write Mobile/",
    "build:desktop": "npm run build --workspace=Desktop",
    "build:mobile": "npm run build --workspace=Mobile",
    "build:mobile:electron": "npm run build:electron --workspace=Mobile",
    "package:desktop": "npm run build:mobile:electron && npm run package --workspace=Desktop",
    "package:mobile": "npm run package --workspace=Mobile",
    "lint:mobile": "npm run lint --workspace=Mobile",
    "test:mobile": "npm run test:ci --workspace=Mobile"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
